# Copy this file to .env.local and fill in real values for local development.
# Configure the same variable names in the Vercel project's Environment
# Variables settings for production/preview deployments.
# Never commit actual secret values.

# Resend (https://resend.com) API key used to send the contact form
# submission email. Used in src/app/api/contact/route.ts.
RESEND_API_KEY=

# Inbox address that receives new contact form submissions.
# Used in src/app/api/contact/route.ts.
CONTACT_TO_EMAIL=

# Verified sender address the contact form email is sent from
# (must be a domain/address verified with Resend).
# Used in src/app/api/contact/route.ts.
CONTACT_FROM_EMAIL=
